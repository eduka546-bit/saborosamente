# Normaliza fim de linha: o repositório usa LF (padrão do Prettier).
# Evita que checkouts no Windows introduzam CRLF e quebrem o lint.
* text=auto eol=lf

# Arquivos binários não devem ser tocados
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
